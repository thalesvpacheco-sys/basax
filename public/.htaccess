# Apache/LiteSpeed (HostGator e Hostinger) — configuração do site estático Basax

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → sem www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Bloqueia arquivos internos de deploy e restos do WordPress antigo
  RewriteRule (^|/)\.cpanel\.yml$ - [F,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin(/.*)?)$ - [F,L]

  # URLs do site antigo (WordPress) → páginas equivalentes do site novo
  RewriteRule ^servicos/condominio/?$   /#servico-condominios  [NE,L,R=301]
  RewriteRule ^pintura-predial/?$       /#servico-retrofit     [NE,L,R=301]
  RewriteRule ^servicos/adm/?$          /#servico-administracao [NE,L,R=301]
  RewriteRule ^servicos/comercial/?$    /#servico-comerciais   [NE,L,R=301]
  RewriteRule ^servicos/industrial/?$   /#servico-industriais  [NE,L,R=301]
  RewriteRule ^servicos/residencial/?$  /#servico-residenciais [NE,L,R=301]
  RewriteRule ^servicos/?$              /#servicos             [NE,L,R=301]
  RewriteRule ^a-empresa/?$             /#empresa              [NE,L,R=301]
  RewriteRule ^(contato|orcamento)/?$   /#orcamento            [NE,L,R=301]
  RewriteRule ^(feed|comments/feed)/?$  /                      [L,R=301]
</IfModule>

# Cabeçalhos de segurança
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Cache: assets com hash no nome (gerados pelo Vite) ficam em cache por 1 ano;
# o HTML é sempre revalidado para que novas publicações apareçam na hora.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
